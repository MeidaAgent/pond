# ============================================================
# Acre Backend Configuration
# Copy this file to `.env` and fill in the values.
# ============================================================

# Server
PORT=4000
NODE_ENV=development
HOST=0.0.0.0

# CORS
# Comma-separated list of allowed origins, or `*` for any
CORS_ORIGIN=https://useacre.xyz

# Rate limit (per IP, per windowMs)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# RPC endpoint (Robinhood Chain JSON-RPC)
# Leave empty to fall back to the in-process mock engine (dev mode only).
RPC_URL=https://rpc.mainnet.chain.robinhood.com/
CHAIN_ID=4663

# Whether to use the mock engine when RPC is unreachable
# Useful for offline development and local testing.
ALLOW_MOCK=true

# Where the keeper registers addresses watching for deposits.
# This mirrors `keeperWatchUrl` on the frontend config.
KEEPER_WATCH_URL=https://useacre.xyz/watch
